{
  "name": "oct-windows-builder",
  "version": "1.0.13",
  "description": "Community project. Windows Builder Console plugin. Not officially supported by Red Hat.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve",
    "ts-check": "tsc --noEmit",
    "webpack": "webpack --config webpack.config.js"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.21.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@patternfly/react-table": "^6.0.0",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.0",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^6.10.0",
    "i18next": "^21.10.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-router": "5.3.4",
    "react-router-dom": "^5.3.4",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "consolePlugin": {
    "name": "oct-windows-builder",
    "version": "1.0.13",
    "displayName": "Windows Builder",
    "description": "Community project. Build sysprepped Windows disks for OpenShift Virtualization. Not officially supported by Red Hat.",
    "exposedModules": {
      "WindowsBuilderPage": "./components/WindowsBuilderPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "packageManager": "yarn@4.17.1"
}
